#!/usr/bin/env bash
# Enforces Conventional Commits: type(scope)!: subject
set -euo pipefail

header="$(head -n1 "$1")"

# Messages created by git or Azure DevOps are allowed as they are.
if printf '%s' "$header" | grep -Eq '^(Merge |Merged PR [0-9]+:|Revert "|fixup! |squash! )'; then
  exit 0
fi

types='feat|fix|refactor|perf|test|docs|build|ci|chore|revert|style'
if ! printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"; then
  cat >&2 <<MSG
commit-msg: header must follow Conventional Commits:

  <type>(<optional scope>)!: <subject>

  type:    $types
  example: feat(login): add OTP resend timer
           fix(network): retry on 502

got: "$header"
MSG
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "commit-msg: header is ${#header} characters; keep it at 72 or fewer." >&2
  exit 1
fi

exit 0
