# Copy to api_end_points.env (git-ignored) and pass it to Flutter with:
#   --dart-define-from-file=api_end_points.env
# FLUTTER_APP_FLAVOR is set automatically by `--flavor <dev|stage|prod>`;
# without a flavor (e.g. web) the prod flavor is used.

# Base URL used by the dev flavor.
BASE_URL_DEV=https://jsonplaceholder.typicode.com
# Base URL used by the stage flavor.
BASE_URL_STAGE=https://jsonplaceholder.typicode.com
# Base URL used by the prod flavor (and as the fallback base URL).
BASE_URL_PROD=https://jsonplaceholder.typicode.com
# Sentry DSN. Sentry is enabled only for the prod flavor when this is non-empty.
SENTRY_DSN=
# Comma-separated SHA-256 certificate fingerprints. Empty = pinning disabled (always disabled on web).
SHA_FINGERPRINTS=
# Release name reported to Sentry (optional, defaults to 1.0.0).
APP_VERSION=1.0.0
